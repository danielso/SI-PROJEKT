{# templates/user/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'title.user_list'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'title.user_list'|trans }}</h1>

    <a class="btn btn-secondary mt-2" href="{{ path('home') }}" role="button">
        ← {{ 'action.back_to_home'|trans }}
    </a>

    <a href="{{ path('user_new') }}" class="btn btn-primary mb-3">
        {{ 'action.add_user'|trans }}
    </a>

    <table class="table">
        <thead>
        <tr>
            <th>{{ 'label.email'|trans }}</th>
            <th>{{ 'label.role'|trans }}</th>
            <th>{{ 'label.status'|trans }}</th>
            <th>{{ 'label.actions'|trans }}</th>
        </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.email }}</td>
                <td>{{ user.roles|join(', ') }}</td>
                <td>{{ user.isBlocked ? 'status.blocked'|trans : 'status.active'|trans }}</td>
                <td>
                    <a href="{{ path('user_edit', {'id': user.id}) }}" class="btn btn-warning">
                        {{ 'action.edit'|trans }}
                    </a>
                    <a href="{{ path('user_delete', {'id': user.id}) }}" class="btn btn-danger">
                        {{ 'action.delete'|trans }}
                    </a>
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
