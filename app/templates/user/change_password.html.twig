{% extends 'base.html.twig' %}

{% block title %}{{ 'title.edit_password'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'title.edit_password_for'|trans({'%email%': user.email}) }}</h1>

    {{ form_start(form) }}
    {{ form_row(form.newPassword.first) }}
    {{ form_row(form.newPassword.second) }}
    <button class="btn btn-primary">{{ 'action.edit_password'|trans }}</button>
    {{ form_end(form) }}

    <p><a href="{{ path('user_edit', { id: user.id }) }}">← {{ 'link.back_to_user_edit'|trans }}</a></p>
{% endblock %}
