{% extends 'base.html.twig' %}

{% block title %}{{ 'title.user_edit'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'title.user_edit_for'|trans({'%email%': user.email}) }}</h1>

    {{ form_start(form) }}
    {{ form_row(form.email) }}
    {{ form_row(form.roles) }}
    {{ form_row(form.isBlocked) }}
    {{ form_end(form) }}

    <hr>
    <a class="btn btn-outline-secondary"
       href="{{ path('user_change_password', {id: user.id}) }}">
        {{ 'action.edit_password'|trans }}
    </a>
{% endblock %}
