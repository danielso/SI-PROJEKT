{% extends 'base.html.twig' %}

{% block title %}{{ 'title.home'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'home.welcome'|trans }}</h1>
    <p>{{ 'home.choose'|trans }}</p>
    <div style="margin-bottom: 1rem;">
        <a href="{{ path('note_index') }}" style="padding: 0.5rem 1rem; background-color: #4CAF50; color: white; border-radius: 5px; text-decoration: none; margin-left: 1rem;">{{ 'action.view_notes'|trans }}</a>
        <a href="{{ path('app_to_do_index') }}" style="padding: 0.5rem 1rem; background-color: #4CAF50; color: white; border-radius: 5px; text-decoration: none; margin-left: 1rem;">{{ 'action.view_todos'|trans }}</a>
        <a href="{{ path('profile_edit') }}" style="padding: 0.5rem 1rem; background-color: #4CAF50; color: white; border-radius: 5px; text-decoration: none; margin-left: 1rem;">{{ 'action.profile'|trans }}</a>

        {% if is_admin %}
            <a href="{{ path('user_index') }}" style="padding: 0.5rem 1rem; background-color: #4CAF50; color: white; border-radius: 5px; text-decoration: none; margin-left: 1rem;">{{ 'action.manage_users'|trans }}</a>
        {% endif %}
    </div>
{% endblock %}
