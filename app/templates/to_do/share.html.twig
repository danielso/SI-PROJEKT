{% extends 'base.html.twig' %}

{% block title %}{{ 'todo.share.title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ to_do.title }}</h1>

    <p><strong>{{ 'label.content'|trans }}:</strong> {{ to_do.content }}</p>

    <p><strong>{{ 'label.category'|trans }}:</strong>
        {{ to_do.category ? to_do.category.name : 'label.none'|trans }}
    </p>

    <p><strong>{{ 'label.status'|trans }}:</strong>
        {{ to_do.isDone ? 'label.is_done'|trans : 'todo.index.status_not_done'|trans }}
    </p>

    <p><strong>{{ 'label.tags'|trans }}:</strong>
        {% if to_do.tags is empty %}
            <em>{{ 'label.none'|trans }}</em>
        {% else %}
            {% for tag in to_do.tags %}
                <span style="display:inline-block;background-color:#e0e0e0;padding:0.2rem 0.5rem;margin-right:0.3rem;border-radius:5px;">
                    {{ tag.name }}
                </span>
            {% endfor %}
        {% endif %}
    </p>
{% endblock %}
