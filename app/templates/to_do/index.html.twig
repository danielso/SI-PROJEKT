{% extends 'base.html.twig' %}

{% block title %}{{ 'todo.index.title'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'todo.index.header'|trans }}</h1>

    <div style="margin-bottom: 1rem;">
        <a href="{{ path('home') }}" class="back-button"
           style="padding: .5rem 1rem; background-color:#4CAF50; color:#fff; border-radius:5px; text-decoration:none; margin-left:1rem;">
            {{ 'todo.index.back_home'|trans }}
        </a>
        <a href="{{ path('app_to_do_new') }}"
           style="padding: .5rem 1rem; background-color:#4CAF50; color:#fff; border-radius:5px; text-decoration:none; margin-left:1rem;">
            {{ 'todo.index.new_task'|trans }}
        </a>
        <a href="{{ path('category_index') }}"
           style="padding: .5rem 1rem; background-color:#4CAF50; color:#fff; border-radius:5px; text-decoration:none; margin-left:1rem;">
            {{ 'todo.index.manage_categories'|trans }}
        </a>
        <a href="{{ path('tag_index') }}"
           style="padding: .5rem 1rem; background-color:#4CAF50; color:#fff; border-radius:5px; text-decoration:none; margin-left:1rem;">
            {{ 'todo.index.manage_tags'|trans }}
        </a>
    </div>

    <form method="get" action="{{ path('app_to_do_index') }}" style="margin-bottom: 1rem;">
        <label for="search">{{ 'todo.index.search_label'|trans }}</label>
        <input type="text" id="search" name="search" value="{{ searchTerm }}"
               placeholder="{{ 'todo.index.search_placeholder'|trans }}">
        <button type="submit">{{ 'todo.index.search_btn'|trans }}</button>
    </form>

    <form method="get" action="{{ path('app_to_do_index') }}" style="margin-bottom: 1rem;">
        <label for="category">{{ 'todo.index.filter_category'|trans }}</label>
        <select name="category" id="category" onchange="this.form.submit()">
            <option value="">{{ 'todo.index.all'|trans }}</option>
            {% for category in categories %}
                <option value="{{ category.id }}" {% if selectedCategory == category.id %}selected{% endif %}>
                    {{ category.name }}
                </option>
            {% endfor %}
        </select>
    </form>

    <form method="get" action="{{ path('app_to_do_index') }}" style="margin-bottom: 1rem;">
        <label for="tag">{{ 'todo.index.filter_tag'|trans }}</label>
        <select name="tag" id="tag" onchange="this.form.submit()">
            <option value="">{{ 'todo.index.all'|trans }}</option>
            {% for tag in tags %}
                <option value="{{ tag.id }}" {% if selectedTag == tag.id %}selected{% endif %}>
                    {{ tag.name }}
                </option>
            {% endfor %}
        </select>
    </form>

    {% for task in to_do %}
        <div style="border:1px solid #ccc; border-radius:8px; padding:1rem; margin-bottom:1rem;">
            <h3 style="margin-top:0;">{{ task.title }}</h3>

            {% if task.user and app.user and app.user.id != task.user.id %}
                <div style="margin:12px 0; padding:8px 12px; background:#eef5ff; border:1px solid #cfe2ff; border-radius:6px;">
                    {{ 'todo.index.shared_by'|trans }} <strong>{{ task.user.email }}</strong>
                </div>
            {% endif %}

            {% if task.content %}
                <p><strong>{{ 'todo.index.content'|trans }}</strong> {{ task.content|markdown_to_html }}</p>
            {% endif %}

            <p><strong>{{ 'todo.index.status'|trans }}</strong>
                {{ task.isDone ? ('todo.index.status_done'|trans) : ('todo.index.status_not_done'|trans) }}
            </p>

            {% if task.category %}
                <p><strong>{{ 'todo.index.category'|trans }}</strong> {{ task.category.name }}</p>
            {% else %}
                <p><strong>{{ 'todo.index.category'|trans }}</strong> <em>{{ 'todo.index.none'|trans }}</em></p>
            {% endif %}

            <p>{{ 'todo.index.tags'|trans }}:
                {% if task.tags is empty %}
                    <em>{{ 'todo.index.none'|trans }}</em>
                {% else %}
                    {% for tag in task.tags %}
                        <span style="display:inline-block; background:#e0e0e0; padding:.2rem .5rem; margin-right:.3rem; border-radius:5px;">
                            {{ tag.name }}
                        </span>
                    {% endfor %}
                {% endif %}
            </p>

            <small>{{ task.createdAt|format_date('long') }}</small>


            <div style="margin-top:.5rem;">
                <a href="{{ path('app_to_do_edit', {'id': task.id}) }}" style="margin-right:.5rem;">
                    {{ 'todo.index.edit'|trans }}
                </a>
                <a href="{{ path('app_to_do_delete', {'id': task.id}) }}" style="margin-left:.5rem;">
                    {{ 'todo.index.delete'|trans }}
                </a>
                {% if is_granted('TODO_LEAVE', task) and leave_forms[task.id] is defined %}
                    {{ form_start(leave_forms[task.id], {attr: {style: 'display:inline; margin-left:.5rem;'} }) }}
                    <button type="submit" class="btn btn-sm btn-outline-secondary">
                        {{ 'todo.leave.button'|trans }}
                    </button>
                    {{ form_end(leave_forms[task.id]) }}
                {% endif %}

            </div>

            {% if task.shareToken %}
                <a href="{{ path('app_to_do_share', {'token': task.shareToken}) }}">
                    {{ 'todo.index.share'|trans }}
                </a>
            {% else %}
                <p>{{ 'todo.index.no_share_token'|trans }}</p>
            {% endif %}
        </div>
    {% else %}
        <p>{{ 'todo.index.empty'|trans }}</p>
    {% endfor %}
{% endblock %}
