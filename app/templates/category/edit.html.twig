{% extends 'base.html.twig' %}

{% block title %}{{ 'edit.category.title'|trans }}{% endblock %}

{% block body %}
    <div class="container">
        <h1>{{ 'edit.category.title'|trans }}: {{ category.name }}</h1>

        {{ form_start(form) }}

        {{ form_errors(form) }}

        <div class="form-group">
            {{ form_row(form.name) }}
        </div>

        <div class="form-group mt-3">
            <button type="submit" class="btn btn-success">{{ 'action.save_changes'|trans }}</button>
            <a href="{{ path('category_index') }}" class="btn btn-secondary ms-2">{{ 'action.cancel'|trans }}</a>
        </div>

        {{ form_end(form) }}
    </div>

{% endblock %}
