{% extends 'base.html.twig' %}

{% block title %}{{ 'title.category.index'|trans }}{% endblock %}

{% block body %}
    <div class="container">
        <h1>{{ 'title.category.index'|trans }}</h1>

        <div style="margin-bottom: 1rem;">
            <a href="{{ path('home') }}" class="back-button"
               style="padding: 0.5rem 1rem; background-color: #4CAF50; color: white; border-radius: 5px; text-decoration: none;">
                {{ 'action.back_home'|trans }}
            </a>
            <a href="{{ path('category_new') }}"
               style="padding: 0.5rem 1rem; background-color: #4CAF50; color: white; border-radius: 5px; text-decoration: none; margin-left: 1rem;">
                {{ 'action.category.new'|trans }}
            </a>
        </div>

        {% if rows is not empty %}
            {% for row in rows %}
                {% set category = row[0] %}
                <div style="border: 1px solid #ccc; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                    <h3 style="margin: 0;">
                        {{ category.name }}
                        <small style="font-weight: normal; color: #666;">
                            {{ 'category.usage_counts'|trans({'%todo%': row.todoCount, '%notes%': row.noteCount}) }}
                        </small>
                    </h3>

                    <div style="margin-top: 10px;">
                        <a href="{{ path('category_edit', { id: category.id }) }}" style="margin-right: 0.5rem;">
                            {{ 'action.edit'|trans }}
                        </a>

                        {% if row.todoCount == 0 and row.noteCount == 0 %}
                            <a href="{{ path('category_delete', { id: category.id }) }}"
                               style="color: red; margin-left: .5rem;">
                                🗑 {{ 'action.delete'|trans }}
                            </a>
                        {% else %}
                            <span title="{{ 'category.locked'|trans }}">🔒</span>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        {% else %}
            <p>{{ 'message.category.empty'|trans }}</p>
        {% endif %}
    </div>
{% endblock %}
