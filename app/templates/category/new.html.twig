{% extends 'base.html.twig' %}

{% block title %}{{ 'title.category.create'|trans }}{% endblock %}

{% block body %}
    <div class="container">
        <h1>{{ 'title.category.create'|trans }}</h1>

        {{ form_start(form) }}

        {{ form_errors(form) }}
        {{ form_row(form.name) }}

        <button type="submit" class="btn btn-primary">{{ 'action.save'|trans }}</button>
        <a href="{{ path('category_index') }}" class="btn btn-secondary">{{ 'action.cancel'|trans }}</a>

        {{ form_end(form) }}
    </div>
{% endblock %}
