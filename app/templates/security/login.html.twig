{% extends 'base.html.twig' %}

{% block title %}{{ 'title.login'|trans }}{% endblock %}

{% block body %}
    <div class="container d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="col-md-4">
            <h2 class="text-center mb-4">{{ 'login.heading'|trans }}</h2>

            {% for msg in app.flashes('error') %}
                <div class="alert alert-danger">{{ msg }}</div>
            {% endfor %}

            <form action="{{ path('app_login') }}" method="post">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="mb-3">
                    <label for="email" class="form-label">{{ 'label.email'|trans }}</label>
                    <input type="email" id="email" name="_username" value="{{ last_username }}" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">{{ 'label.password'|trans }}</label>
                    <input type="password" id="password" name="_password" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    {{ 'action.sign_in'|trans }}
                </button>
            </form>


            {% if error %}
                <div class="alert alert-danger">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <div class="mt-3 text-center">
                <a href="{{ path('app_register') }}">{{ 'login.no_account'|trans }}</a>
            </div>
        </div>
    </div>
{% endblock %}
