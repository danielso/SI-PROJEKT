{% extends 'base.html.twig' %}

{% block title %}{{ 'title.register'|trans }}{% endblock %}

{% block body %}
    <div class="container">
        <h1>{{ 'register.heading'|trans }}</h1>

        {{ form_start(registrationForm) }}

        <div class="form-group">
            {{ form_label(registrationForm.email, 'label.register.email'|trans) }}
            {{ form_widget(registrationForm.email, {
                attr: {
                    class: 'form-control' ~ (registrationForm.email.vars.errors|length ? ' is-invalid' : '')
                }
            }) }}
            <div class="invalid-feedback">
                {{ form_errors(registrationForm.email) }}
            </div>
        </div>

        <div class="form-group">
            {# RepeatedType sam wyrenderuje dwie kontrolki z etykietami z FormType #}
            {{ form_widget(registrationForm.plainPassword, {
                attr: { class: 'form-control' }
            }) }}
            <div class="invalid-feedback">
                {{ form_errors(registrationForm.plainPassword) }}
            </div>
        </div>

        <button class="btn btn-primary" type="submit">{{ 'action.sign_up'|trans }}</button>

        {{ form_end(registrationForm) }}

        <p class="mt-3">
            {{ 'register.have_account'|trans }}
            <a href="{{ path('app_login') }}">{{ 'action.sign_in'|trans }}</a>
        </p>
    </div>
{% endblock %}
