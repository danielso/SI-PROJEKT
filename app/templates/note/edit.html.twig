{% extends 'base.html.twig' %}

{% block title %}{{ 'title.note_edit'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'note.edit_heading'|trans }}</h1>

    {{ form_start(form) }}

    <div>
        {{ form_row(form.title,      {'label': 'label.title'}) }}
    </div>

    <div>
        {{ form_row(form.content,    {'label': 'label.content'}) }}
    </div>

    <div>
        {{ form_row(form.image,      {'label': 'label.image'}) }}
    </div>

    <div>
        {{ form_row(form.category,   {'label': 'label.category'}) }}
    </div>

    <div>
        {{ form_row(form.newCategory,{'label': 'label.new_category'}) }}
    </div>

    <div>
        {{ form_row(form.tags,       {'label': 'label.tags'}) }}
    </div>

    <div>
        <button type="submit" class="btn btn-primary">{{ 'action.save_changes'|trans }}</button>
    </div>

    {{ form_end(form) }}

    <p><a href="{{ path('note_index') }}">{{ 'action.back_to_notes'|trans }}</a></p>
{% endblock %}
