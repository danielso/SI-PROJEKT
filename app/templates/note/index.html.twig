{% extends 'base.html.twig' %}

{% block title %}{{ 'title.note_index'|trans }}{% endblock %}

{% block body %}
    <div class="container">
        <h1>{{ 'note.list_heading'|trans }}</h1>

        <div style="margin-bottom: 1rem;">
            <a href="{{ path('home') }}" class="back-button"
               style="padding: 0.5rem 1rem; background-color: #4CAF50; color: white; border-radius: 5px; text-decoration: none; margin-left: 1rem;">
                {{ 'action.back_home'|trans }}
            </a>
            <a href="{{ path('note_new') }}" class="add-button"
               style="padding: 0.5rem 1rem; background-color: #4CAF50; color: white; border-radius: 5px; text-decoration: none; margin-left: 1rem;">
                {{ 'action.add_note'|trans }}
            </a>
            <a href="{{ path('category_index') }}"
               style="padding: 0.5rem 1rem; background-color: #4CAF50; color: white; border-radius: 5px; text-decoration: none; margin-left: 1rem;">
                {{ 'action.manage_categories'|trans }}
            </a>
            <a href="{{ path('tag_index') }}"
               style="padding: 0.5rem 1rem; background-color: #4CAF50; color: white; border-radius: 5px; text-decoration: none; margin-left: 1rem;">
                {{ 'action.manage_tags'|trans }}
            </a>
        </div>

        <form method="get" action="{{ path('note_index') }}" style="margin-bottom: 1rem;">
            <label for="search">{{ 'label.search_notes'|trans }}</label>
            <input type="text" id="search" name="search" value="{{ searchTerm }}" placeholder="{{ 'placeholder.search_notes'|trans }}">
            <button type="submit">{{ 'action.search'|trans }}</button>
        </form>

        <form method="get" action="{{ path('note_index') }}" style="margin-bottom: 1rem;">
            <label for="category">{{ 'label.filter_by_category'|trans }}</label>
            <select name="category" id="category" onchange="this.form.submit()">
                <option value="">{{ 'label.all'|trans }}</option>
                {% for category in categories %}
                    <option value="{{ category.id }}" {% if selectedCategory == category.id %}selected{% endif %}>{{ category.name }}</option>
                {% endfor %}
            </select>
        </form>

        <form method="get" action="{{ path('note_index') }}" style="margin-bottom: 1rem;">
            <label for="tag">{{ 'label.filter_by_tag'|trans }}</label>
            <select name="tag" id="tag" onchange="this.form.submit()">
                <option value="">{{ 'label.all'|trans }}</option>
                {% for tag in tags %}
                    <option value="{{ tag.id }}" {% if selectedTag == tag.id %}selected{% endif %}>{{ tag.name }}</option>
                {% endfor %}
            </select>
        </form>

        {% if notes is empty %}
            <p>{{ 'message.no_notes'|trans }}</p>
        {% else %}
            {% for note in notes %}
                <div style="border: 1px solid #ccc; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;">
                    <h3>{{ note.title }}</h3>

                    {% if note.image %}
                        <img src="{{ asset('uploads/images/' ~ note.image) }}" alt="{{ note.title }}" style="max-width: 100%; height: auto; border-radius: 5px;">
                    {% endif %}

                    <p>{{ note.content|markdown_to_html }}</p>

                    <p>{{ 'label.category'|trans }}:
                        {{ note.category ? note.category.name : ('label.none'|trans) }}
                    </p>

                    <p>{{ 'label.tags'|trans }}:
                        {% if note.tags is empty %}
                            <em>{{ 'label.none'|trans }}</em>
                        {% else %}
                            {% for tag in note.tags %}
                                <span style="display: inline-block; background-color: #e0e0e0; padding: 0.2rem 0.5rem; margin-right: 0.3rem; border-radius: 5px;">
                                    {{ tag.name }}
                                </span>
                            {% endfor %}
                        {% endif %}
                    </p>

                    <small>
                        {{ note.createdAt ? note.createdAt|format_datetime('long', 'short') : '' }}
                    </small>

                    <div style="margin-top: 10px;">
                        <a href="{{ path('note_edit', { id: note.id }) }}">{{ 'action.edit'|trans }}</a>
                        {# Bez confirm(), przejście do strony potwierdzenia (GET) #}
                        <a href="{{ path('note_delete', { id: note.id }) }}" style="margin-left:.5rem;">
                            {{ 'action.delete'|trans }}
                        </a>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>
{% endblock %}
