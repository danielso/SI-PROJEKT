{% extends 'base.html.twig' %}

{% block title %}{{ 'title.note_new'|trans }}{% endblock %}

{% block body %}
    <h1>{{ 'note.add_heading'|trans }}</h1>

    {{ form_start(form) }}
    {{ form_row(form.title) }}
    {{ form_row(form.content) }}
    {{ form_row(form.image) }}
    {{ form_row(form.categoryName) }}
    {{ form_row(form.tags) }}

    {{ form_end(form) }}

    <a href="{{ path('note_index') }}">{{ 'action.back_to_notes'|trans }}</a>
{% endblock %}
