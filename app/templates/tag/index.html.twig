{# templates/tag/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Zarządzaj tagami{% endblock %}

{% block body %}
    <div class="container">
        <h1>Zarządzaj tagami</h1>

        <div style="margin-bottom: 1rem;">
            <a href="{{ path('note_index') }}" class="back-button" style="padding: 0.5rem 1rem; background-color: #4CAF50; color: white; border-radius: 5px; text-decoration: none;">← Wróć do notatek</a>
            <a href="{{ path('tag_new') }}" class="add-button" style="padding: 0.5rem 1rem; background-color: #4CAF50; color: white; border-radius: 5px; text-decoration: none; margin-left: 1rem;">➕ Dodaj nowy tag</a>
        </div>

        {% if rows is empty %}
            <p>Brak tagów do wyświetlenia.</p>
        {% else %}
            <table>
                <thead>
                <tr>
                    <th>Nazwa</th>
                    <th>ToDo</th>
                    <th>Notatki</th>
                    <th>Akcje</th>
                </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    {% set tag = row[0] %}
                    <tr>
                        <td>{{ tag.name }}</td>
                        <td>{{ row.todoCount }}</td>
                        <td>{{ row.noteCount }}</td>
                        <td>
                            <a href="{{ path('tag_edit', {id: tag.id}) }}">✏️</a>
                            {% if row.todoCount == 0 and row.noteCount == 0 %}
                                <form method="post" action="{{ path('tag_delete', {id: tag.id}) }}" style="display:inline" onsubmit="return confirm('Usunąć tag?')">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tag.id) }}">
                                    <button>🗑</button>
                                </form>
                            {% else %}
                                <span title="Tag używany – nie można usunąć">🔒</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
