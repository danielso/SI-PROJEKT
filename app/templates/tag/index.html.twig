{# templates/tag/index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}{{ 'tag.index.title'|trans }}{% endblock %}

{% block body %}
    <div class="container">
        <h1>{{ 'tag.index.title'|trans }}</h1>

        <div style="margin-bottom: 1rem;">
            <a href="{{ path('note_index') }}" class="back-button"
               style="padding: 0.5rem 1rem; background-color: #4CAF50; color: white; border-radius: 5px; text-decoration: none;">
                ← {{ 'action.back_to_notes'|trans }}
            </a>
            <a href="{{ path('tag_new') }}" class="add-button"
               style="padding: 0.5rem 1rem; background-color: #4CAF50; color: white; border-radius: 5px; text-decoration: none; margin-left: 1rem;">
                {{ 'action.add_tag'|trans }}
            </a>
        </div>

        {% if rows is empty %}
            <p>{{ 'message.no_tags'|trans }}</p>
        {% else %}
            <table>
                <thead>
                <tr>
                    <th>{{ 'label.name'|trans }}</th>
                    <th>{{ 'label.todo'|trans }}</th>
                    <th>{{ 'label.notes'|trans }}</th>
                    <th>{{ 'label.actions'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    {% set tag = row[0] %}
                    <tr>
                        <td>{{ tag.name }}</td>
                        <td>{{ row.todoCount }}</td>
                        <td>{{ row.noteCount }}</td>
                        <td>
                            <a href="{{ path('tag_edit', {id: tag.id}) }}">{{ 'action.edit'|trans }}</a>
                            {% if row.todoCount == 0 and row.noteCount == 0 %}
                                <a href="{{ path('tag_delete', {id: tag.id}) }}" style="margin-left:.5rem;">
                                    {{ 'action.delete'|trans }}
                                </a>
                            {% else %}
                                <span title="{{ 'message.tag_in_use'|trans }}">{{ 'message.tag_in_use'|trans }}</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
{% endblock %}
