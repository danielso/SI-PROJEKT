{% extends 'base.html.twig' %}

{% block title %}{{ 'edit.tag.title'|trans }}{% endblock %}

{% block body %}
    <div class="container">
        <h1>{{ 'edit.tag.title'|trans }}: {{ tag.name }}</h1>

        {{ form_start(form) }}

        {{ form_errors(form) }}

        <div class="mb-3">
            {{ form_row(form.name) }}
        </div>

        <div class="d-flex gap-2 mt-2">
            <button type="submit" class="btn btn-success">{{ 'action.save_changes'|trans }}</button>
            <a href="{{ path('tag_index') }}" class="btn btn-secondary">{{ 'action.cancel'|trans }}</a>
        </div>

        {{ form_end(form) }}
    </div>

{% endblock %}
